# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=auth_session
POSTGRES_USER=auth_session
POSTGRES_PASS=

# Приложение
BACKEND_PORT=8000
SESSION_EXPIRATION_MINUTES=10080

# Создать один раз: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_TOKEN_HASH_SECRET=

# Для HTTP: SESSION_COOKIE_NAME=session, SESSION_COOKIE_SECURE=false.
SESSION_COOKIE_NAME=__Host-session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
